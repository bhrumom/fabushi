# Copy to the server's secret/config store. Never commit the copy or put these
# values in GitHub Actions, a GitHub release, or a plugin package.
MARKETPLACE_SECURITY_API_BASE_URL=https://api.ombhrum.com
MARKETPLACE_SECURITY_TOKEN=replace-with-a-random-rotated-worker-token
MARKETPLACE_SECURITY_SERVER_ID=security-gate-01
# Exact 40-character commit SHA of the deployed scanner service revision.
MARKETPLACE_SECURITY_SOURCE_SHA=0000000000000000000000000000000000000000
MARKETPLACE_SECURITY_WORK_ROOT=/var/lib/fabushi-marketplace-security

# Server-resident signing material. The private key must never leave this host.
MARKETPLACE_COSIGN_PRIVATE_KEY_FILE=/etc/fabushi/marketplace-cosign.key
MARKETPLACE_COSIGN_PUBLIC_KEY_FILE=/etc/fabushi/marketplace-cosign.pub
# Optional; omit when the Cosign key is unencrypted. If set, the file must be
# readable only by the dedicated service account.
MARKETPLACE_COSIGN_PASSWORD_FILE=/etc/fabushi/marketplace-cosign.password

# All container image references must be replaced with verified immutable
# sha256 digests before the service is started in production.
MARKETPLACE_GITLEAKS_IMAGE=zricethezav/gitleaks:v8.28.0@sha256:replace-with-64-hex-digest
MARKETPLACE_SYFT_IMAGE=anchore/syft:v1.31.0@sha256:replace-with-64-hex-digest
MARKETPLACE_OSV_IMAGE=ghcr.io/google/osv-scanner:v2.0.2@sha256:replace-with-64-hex-digest
MARKETPLACE_NODE_IMAGE=node:22-bookworm-slim@sha256:replace-with-64-hex-digest
MARKETPLACE_GITLEAKS_VERSION=8.28.0
MARKETPLACE_SYFT_VERSION=1.31.0
MARKETPLACE_OSV_VERSION=2.0.2
MARKETPLACE_NODE_VERSION=22-bookworm-slim

MARKETPLACE_SECURITY_POLL_INTERVAL_MS=60000
MARKETPLACE_MAX_PACKAGE_BYTES=104857600
# Optional host ClamAV database directory.
# MARKETPLACE_CLAM_DATABASE_DIR=/var/lib/clamav
