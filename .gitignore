# 构建日志与本地缓存
fabushi/build_output.txt
fabushi/build_output_full.txt
fabushi/flutter_logs_capture.txt
fabushi/playwright-report/
fabushi/test-results/
fabushi/test_bundle.dart
fabushi/patrol_test/test_bundle.dart
