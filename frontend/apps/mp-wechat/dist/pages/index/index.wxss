.chat-page{background:radial-gradient(circle at 48% 0,rgba(34,75,86,.62),transparent 32%),linear-gradient(180deg,#28313a,#1a2025 48%,#111417);min-height:100vh;overflow:hidden;padding:72rpx 28rpx 132rpx;position:relative}.topbar{align-items:center;display:flex;height:92rpx;justify-content:center;left:0;padding:0 28rpx;position:fixed;right:0;top:0;z-index:8}.brand{color:#fff;font-size:34rpx;font-weight:800}.menu-button{align-items:center;background:rgba(19,28,34,.78);border-radius:50%;color:#fff;display:flex;font-size:32rpx;height:60rpx;justify-content:center;left:24rpx;position:absolute;top:16rpx;width:60rpx}.chat-main{min-height:calc(100vh - 204rpx)}.intro{margin-top:120rpx}.greeting{color:#fff;display:block;font-size:58rpx;font-weight:900;line-height:1.18}.subtitle{color:hsla(0,0%,100%,.72);display:block;font-size:30rpx;font-weight:700;margin-top:22rpx}.suggestions{display:flex;flex-wrap:wrap;gap:16rpx;margin-top:44rpx}.suggestion{align-items:center;background:rgba(31,32,37,.88);border-radius:999rpx;color:hsla(0,0%,100%,.78);display:flex;font-size:27rpx;font-weight:800;gap:12rpx;height:72rpx;justify-content:center;padding:0 24rpx}.suggestion-icon{color:#7cc8ff;font-size:30rpx}.messages{margin-top:50rpx;padding-bottom:24rpx}.message{border-radius:8rpx;font-size:28rpx;line-height:1.6;margin-top:18rpx;max-width:86%;padding:20rpx 24rpx}.message.assistant{background:hsla(0,0%,100%,.08);color:hsla(0,0%,100%,.86)}.message.user{background:hsla(0,0%,100%,.94);color:#111417;margin-left:auto}.composer{align-items:center;background:rgba(41,42,46,.92);border:1rpx solid hsla(0,0%,100%,.16);border-radius:44rpx;bottom:26rpx;box-shadow:0 18rpx 48rpx rgba(0,0,0,.32);display:flex;gap:12rpx;left:24rpx;min-height:88rpx;padding:10rpx;position:fixed;right:24rpx;z-index:8}.add-button,.send-button{align-items:center;background:#393b40;border-radius:50%;color:#fff;display:flex;font-size:42rpx;font-weight:500;height:68rpx;justify-content:center;min-width:68rpx;width:68rpx}.send-button{background:#45474d;font-size:34rpx;font-weight:800}.chat-input{background:hsla(0,0%,100%,.07);border:1rpx solid hsla(0,0%,100%,.16);border-radius:32rpx;color:#fff;flex:1;font-size:27rpx;height:64rpx;padding:0 18rpx}.scrim{background:rgba(0,0,0,.42);bottom:0;left:0;position:fixed;right:0;top:0;z-index:20}.sidebar{background:#1f2025;border-bottom-right-radius:30rpx;border-top-right-radius:30rpx;bottom:0;left:-92vw;padding:82rpx 42rpx 42rpx;position:fixed;top:0;transition:left .22s ease;width:86vw;z-index:21}.sidebar.open{left:0}.sidebar-header{align-items:center;display:flex;justify-content:space-between}.sidebar-title{color:#fff;font-size:58rpx;font-weight:900}.close-button{align-items:center;background:transparent;color:#c6c7cc;display:flex;font-size:58rpx;height:70rpx;justify-content:center;width:70rpx}.sidebar-user{margin-top:60rpx}.user-profile{align-items:center;display:flex;gap:24rpx}.user-avatar{background:#2a2d33;border-radius:50%;height:100rpx;width:100rpx}.user-info{display:flex;flex-direction:column;gap:8rpx}.user-name{color:#fff;font-size:36rpx;font-weight:800}.user-membership{color:#7cc8ff;font-size:24rpx;font-weight:500}.wechat-login-btn{align-items:center;background:#07c160;border-radius:20rpx;color:#fff;display:flex;font-size:32rpx;font-weight:800;gap:16rpx;height:100rpx;justify-content:center}.wechat-icon{font-size:44rpx}.new-chat{align-items:center;background:#30353a;border-radius:34rpx;color:#fff;display:flex;font-size:36rpx;font-weight:800;gap:22rpx;height:116rpx;justify-content:center;margin-top:72rpx}.new-chat-icon{font-size:44rpx}.today{color:#777981;display:block;font-size:40rpx;font-weight:900;margin-top:70rpx}.empty{color:#bbbcc2;display:flex;font-size:38rpx;font-weight:900;justify-content:center;left:0;position:absolute;right:0;top:58%}