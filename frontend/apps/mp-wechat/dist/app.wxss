:root{--space-deep-blue:#0b0e14;--space-blue:#1b263b;--starlight-white:#e8eaf6;--nebula-purple:#7b1fa2;--nebula-pink:#e91e63;--cosmic-gold:gold;--glass-border:hsla(0,0%,100%,.15);--glass-surface:hsla(0,0%,100%,.1)}page{background:var(--space-deep-blue);color:var(--starlight-white);font-family:PingFang SC,Hiragino Sans GB,sans-serif}button,input,text,textarea,view{box-sizing:border-box}button{border-radius:8rpx;line-height:1;margin:0;padding:0}button::after{border:0}.glass-card{backdrop-filter:blur(20rpx);background:var(--glass-surface);border:1rpx solid var(--glass-border);border-radius:20rpx}.cosmic-gradient{background:linear-gradient(135deg,var(--space-deep-blue),#1a237e)}.nebula-gradient{background:linear-gradient(135deg,var(--nebula-purple),var(--nebula-pink))}