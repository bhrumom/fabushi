{
  "manifest_version": 3,
  "name": "Fabushi",
  "short_name": "Fabushi",
  "version": "0.3.0",
  "minimum_chrome_version": "120",
  "description": "Fabushi for Chrome — your Fabushi workspace and a secure bridge between the desktop app and the browser you already use.",
  "permissions": [
    "alarms",
    "debugger",
    "downloads",
    "nativeMessaging",
    "storage",
    "tabGroups",
    "tabs",
    "webNavigation"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Fabushi",
    "default_popup": "app.html"
  }
}
