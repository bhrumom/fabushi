{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "发布软件",
  "identifier": "com.ombhrum.fabushi",
  "app": {
    "security": {
      "capabilities": [
        {
          "identifier": "functional-e2e",
          "description": "PR-only embedded WebDriver capability for the packaged macOS functional test.",
          "windows": ["main"],
          "permissions": ["core:default", "wdio-webdriver:default"]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"]
  }
}
