{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fabushi",
  "version": "0.1.0",
  "identifier": "com.ombhrum.fabushi",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Fabushi Mahayana Host",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false
  }
}
