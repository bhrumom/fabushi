{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "发布软件",
  "version": "1.0.0",
  "identifier": "com.ombhrum.fabushi.tauri",
  "build": {
    "beforeDevCommand": "cd ../../frontend && corepack pnpm --filter @fabushi/host dev",
    "beforeBuildCommand": "cd ../../frontend && corepack pnpm --filter @fabushi/host build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../../../frontend/apps/host/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "发布软件",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false
  }
}
