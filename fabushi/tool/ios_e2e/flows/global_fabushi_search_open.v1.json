{
  "schemaVersion": 1,
  "name": "global-fabushi-production-install-search-open",
  "steps": [
    {
      "name": "initial-app-state",
      "action": "capture"
    },
    {
      "name": "wait-chat-search",
      "action": "wait",
      "locator": {
        "using": "accessibility id",
        "value": "e2e.chat.search"
      },
      "timeoutSeconds": 60
    },
    {
      "name": "search-global-fabushi",
      "action": "type",
      "locator": {
        "using": "accessibility id",
        "value": "e2e.chat.search"
      },
      "text": "{{query}}"
    },
    {
      "name": "wait-target-registry-result",
      "action": "assertPresent",
      "locator": {
        "using": "accessibility id",
        "value": "e2e.miniapp.result.{{pluginId}}.registry"
      },
      "timeoutSeconds": 60
    },
    {
      "name": "assert-target-is-not-preinstalled",
      "action": "assertAbsent",
      "locator": {
        "using": "accessibility id",
        "value": "e2e.miniapp.result.{{pluginId}}.installed"
      },
      "timeoutSeconds": 3
    },
    {
      "name": "install-target-through-app",
      "action": "tap",
      "locator": {
        "using": "accessibility id",
        "value": "e2e.miniapp.install.{{pluginId}}"
      }
    },
    {
      "name": "wait-verified-installed-result",
      "action": "assertPresent",
      "locator": {
        "using": "accessibility id",
        "value": "e2e.miniapp.result.{{pluginId}}.installed"
      },
      "timeoutSeconds": 120,
      "evidence": true
    },
    {
      "name": "open-installed-chat",
      "action": "tap",
      "locator": {
        "using": "accessibility id",
        "value": "e2e.miniapp.result.{{pluginId}}.installed"
      }
    },
    {
      "name": "wait-installed-chat",
      "action": "assertPresent",
      "locator": {
        "using": "accessibility id",
        "value": "e2e.miniapp.chat.{{pluginId}}.installed"
      },
      "timeoutSeconds": 60
    },
    {
      "name": "open-miniapp-host",
      "action": "tap",
      "locator": {
        "using": "accessibility id",
        "value": "e2e.miniapp.open.{{pluginId}}"
      }
    },
    {
      "name": "wait-webview-runtime-ready",
      "action": "assertPresent",
      "locator": {
        "using": "accessibility id",
        "value": "e2e.miniapp.host.{{pluginId}}.ready"
      },
      "timeoutSeconds": 120
    },
    {
      "name": "final-ready-state",
      "action": "capture"
    }
  ]
}
