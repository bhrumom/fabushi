{
  "schema": 1,
  "version": "openclaw-embedded-2026.06.3",
  "defaultPort": 18789,
  "defaultModel": "deepseek/deepseek-chat",
  "defaultModelOverride": "",
  "gatewayArgs": [
    "gateway",
    "--port",
    "{port}",
    "--force"
  ],
  "bundledPlugins": [
    {
      "id": "openclaw-weixin",
      "package": "@tencent-weixin/openclaw-weixin",
      "version": "2.4.3",
      "path": "plugins/openclaw-weixin",
      "channel": "openclaw-weixin"
    }
  ],
  "platforms": {
    "macos-arm64": {
      "nodeExecutable": "node/bin/node",
      "cliEntrypoint": "openclaw/openclaw.mjs"
    },
    "macos-x64": {
      "nodeExecutable": "node/bin/node",
      "cliEntrypoint": "openclaw/openclaw.mjs"
    },
    "windows-x64": {
      "nodeExecutable": "node/node.exe",
      "cliEntrypoint": "openclaw/openclaw.mjs"
    },
    "linux-x64": {
      "nodeExecutable": "node/bin/node",
      "cliEntrypoint": "openclaw/openclaw.mjs"
    },
    "linux-arm64": {
      "nodeExecutable": "node/bin/node",
      "cliEntrypoint": "openclaw/openclaw.mjs"
    },
    "windows-arm64": {
      "nodeExecutable": "node/node.exe",
      "cliEntrypoint": "openclaw/openclaw.mjs"
    }
  }
}
